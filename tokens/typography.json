{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter Variable", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 900 }
    }
  },
  "text": {
    "$type": "dimension",
    "$description": "Fluid type scale. Display sizes scale with viewport and stay readable at 200% zoom because they are rem-based.",
    "stat": { "$value": "clamp(5rem, 3rem + 10vw, 9rem)", "$description": "Giant Wrapped numbers" },
    "display": { "$value": "clamp(2.5rem, 1.75rem + 3.5vw, 4.5rem)" },
    "h1": { "$value": "clamp(2rem, 1.6rem + 2vw, 3rem)" },
    "h2": { "$value": "clamp(1.5rem, 1.3rem + 1vw, 2rem)" },
    "h3": { "$value": "1.25rem" },
    "body": { "$value": "1rem" },
    "small": { "$value": "0.875rem" },
    "eyebrow": { "$value": "0.8125rem" }
  },
  "leading": {
    "$type": "number",
    "tight": { "$value": 0.9 },
    "snug": { "$value": 1.15 },
    "normal": { "$value": 1.5 }
  },
  "tracking": {
    "$type": "dimension",
    "display": { "$value": "-0.05em", "$description": "Tight tracking for Inter 900 headlines" },
    "heading": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "eyebrow": { "$value": "0.12em" }
  }
}
