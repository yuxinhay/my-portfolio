{
  "scene": {
    "$type": "color",
    "$description": "A scene is one Wrapped-style section: a surface with the text, accent, display, focus and shape colours that are allowed on it, and a surface fill for panels inside it. Every text role is contrast-checked against bg and against surface in CI.",
    "blush": {
      "bg": { "$value": "{color.blush}" },
      "fg": { "$value": "{color.ink.900}" },
      "accent": { "$value": "{color.pink.700}" },
      "display": {
        "$value": "{color.pink.600}",
        "$description": "Giant display type, e.g. the name on the intro's first card: the hot pink of the owner's mockup (4.74:1)"
      },
      "focus": { "$value": "{color.ink.900}" },
      "shape": { "$value": "{color.pink.300}" },
      "surface": { "$value": "{color.white}" }
    },
    "pink": {
      "bg": { "$value": "{color.pink.600}" },
      "fg": { "$value": "{color.white}" },
      "accent": { "$value": "{color.blush}" },
      "display": { "$value": "{color.blush}" },
      "focus": { "$value": "{color.white}" },
      "shape": { "$value": "{color.pink.500}" },
      "surface": { "$value": "{color.pink.700}" }
    },
    "cobalt": {
      "bg": { "$value": "{color.cobalt.500}" },
      "fg": { "$value": "{color.white}" },
      "accent": { "$value": "{color.blush}" },
      "display": { "$value": "{color.blush}" },
      "focus": { "$value": "{color.white}" },
      "shape": { "$value": "{color.cobalt.400}" },
      "surface": { "$value": "{color.ink.900}" }
    },
    "ink": {
      "bg": { "$value": "{color.ink.900}" },
      "fg": { "$value": "{color.blush}" },
      "accent": { "$value": "{color.blush}" },
      "display": { "$value": "{color.blush}" },
      "focus": { "$value": "{color.pink.300}" },
      "shape": { "$value": "{color.ink.800}" },
      "surface": { "$value": "{color.ink.800}" }
    }
  }
}
